# Copy to .env (gitignored). The loop's agents source it; the CLI reads the same names.
ASANA_TOKEN=
# Optional: workspace name or gid, needed only if the token can see several
ASANA_WORKSPACE=

# Redactions applied to every captured transcript (from=to, comma separated),
# so a personal address or handle never lands in a committed transcript.
CAPTURE_REDACT=me@example.com=user@example.com
